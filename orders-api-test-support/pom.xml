<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.dmitrykislov</groupId>
    <artifactId>contract-first-spring</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>orders-api-test-support</artifactId>
  <name>orders-api-test-support</name>
  <description>
    Test-scope library shared by the server and end-to-end tests: validates recorded HTTP exchanges against the
    Orders API contract (MockMvc results and real RestClient calls) and enumerates the contract's operations.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.github.dmitrykislov</groupId>
      <artifactId>orders-api-spec</artifactId>
    </dependency>
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>openapi-request-validator-core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.swagger.parser.v3</groupId>
      <artifactId>swagger-parser</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
    </dependency>
    <dependency>
      <!-- Compile-only: MockMvcContract reads MockHttpServletRequest/Response; consumers that use it are
           servlet applications and already carry the API at runtime. -->
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
    </dependency>
  </dependencies>
</project>
